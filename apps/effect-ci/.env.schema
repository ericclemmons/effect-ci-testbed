# @currentEnv=$NODE_ENV
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=false)
# ---

# @type=enum(development,test,production) @internal
NODE_ENV=production

# @type=opServiceAccountToken @required @sensitive @internal
OP_TOKEN=

# @type=string @required @sensitive=false
CLOUDFLARE_ACCOUNT_ID=

# @type=enum(standalone,demo) @required @sensitive=false
EFFECT_CI_PROFILE=demo

# @required @sensitive=false
EFFECT_CI_WORKER_NAME=effect-ci-github-cloudflare

# @required @sensitive=false
EFFECT_CI_PROJECT_ROOT=.

# @type=url @required @sensitive=false
EFFECT_CI_PUBLIC_URL=

# @required @sensitive=false
GITHUB_APP_ID=

# @required @sensitive
GITHUB_PRIVATE_KEY=op(op://effect-ci-production/host/GITHUB_PRIVATE_KEY)

# @required @sensitive
GITHUB_WEBHOOK_SECRET=op(op://effect-ci-production/host/GITHUB_WEBHOOK_SECRET)

# @required @sensitive
EFFECT_CI_API_TOKEN=op(op://effect-ci-production/host/EFFECT_CI_API_TOKEN)

# @required @sensitive
RECEIPT_SIGNING_KEY=op(op://effect-ci-production/host/RECEIPT_SIGNING_KEY)

# @required @sensitive=false
EFFECT_CI_ACCESS_ISSUER=

# @required @sensitive=false
EFFECT_CI_ACCESS_AUD=

# @required @sensitive=false
EFFECT_CI_OIDC_OWNER_IDS=

# @optional @sensitive
CLOUDFLARE_TOKEN_ISSUER=

# @optional @sensitive=false
EFFECT_CI_OIDC_SCOPES=

# Connected-service settings for the complete host.

# @optional @sensitive
CLOUDFLARE_API_TOKEN=

# @optional @sensitive
SLACK_BOT_TOKEN=

# @optional @sensitive
SLACK_SIGNING_SECRET=

# @optional @sensitive=false
SLACK_APP_ID=

# @optional @sensitive=false
SLACK_TEAM_ID=

# @optional @sensitive=false
SLACK_CHANNEL_ID=

# @optional @sensitive=false
SLACK_APPROVER_IDS=

# @optional @sensitive=false
EFFECT_CI_DETAILS_URL=
