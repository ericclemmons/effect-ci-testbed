{
  "name": "effect-ci-testbed",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @effect-ci-testbed/ci build",
    "check": "pnpm --filter './packages/*' --filter './apps/*' check && node scripts/check-examples.ts && pnpm --filter cf-ci-demo check && node scripts/check-example-plans.ts && node --test scripts/check-recipe-docs.test.ts scripts/example-ergonomics.test.ts",
    "ci:hitl-deploy": "EFFECT_CI_APPROVAL=approved EFFECT_CI_EVENT=workflow_dispatch cf-ci run --workflow examples/hitl-deploy/.cloudflare/ci/workflow.ts",
    "ci:hitl-deploy:dry-run": "EFFECT_CI_EVENT=workflow_dispatch cf-ci --workflow examples/hitl-deploy/.cloudflare/ci/workflow.ts plan",
    "ci:cloudflare-runner": "EFFECT_CI_EVENT=workflow_dispatch cf-ci run --workflow examples/cloudflare-runner/.cloudflare/ci/workflow.ts",
    "ci:cloudflare-runner:dry-run": "EFFECT_CI_EVENT=workflow_dispatch cf-ci --workflow examples/cloudflare-runner/.cloudflare/ci/workflow.ts plan",
    "ci:node-npm": "cf-ci run --workflow examples/node-npm/.cloudflare/ci/workflow.ts --format=text",
    "ci:node-npm:dry-run": "cf-ci --workflow examples/node-npm/.cloudflare/ci/workflow.ts plan --format=text",
    "ci:node-pnpm": "cf-ci run --workflow examples/node-pnpm/.cloudflare/ci/workflow.ts --format=text",
    "ci:node-pnpm:dry-run": "cf-ci --workflow examples/node-pnpm/.cloudflare/ci/workflow.ts plan --format=text"
  },
  "devDependencies": {
    "@effect-ci-testbed/ci": "workspace:*",
    "@effect-ci-testbed/cli": "workspace:*",
    "@effect-ci-testbed/cloudflare": "workspace:*",
    "@effect-ci-testbed/local-container": "workspace:*",
    "@types/node": "^26.6.3",
    "effect": "4.0.0-beta.19",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1"
}
