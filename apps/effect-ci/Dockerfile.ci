FROM node:24-trixie-slim

ENV WRANGLER_CI_OVERRIDE_NETWORK_MODE_HOST=1

RUN apt-get update \
  && apt-get install --yes --no-install-recommends bash ca-certificates git python3 docker.io docker-cli docker-buildx \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global pnpm@12.8.1 --ignore-scripts

COPY --from=docker.io/cloudflare/sandbox:1.0.0 \
  /usr/local/bin/sandbox-shim \
  /usr/local/bin/sandbox-shim

RUN mkdir -p /workspace
WORKDIR /workspace
CMD ["sleep", "infinity"]
