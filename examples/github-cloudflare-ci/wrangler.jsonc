{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "effect-ci-github-cloudflare",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "WorkspaceContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "workspace": {
          "dockerfile": "../../packages/cloudflare/Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "WorkspaceContainer",
        "name": "Workspace"
      }
    ]
  },
  "exports": {
    "WorkspaceContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "workflows": [
    {
      "binding": "EFFECT_CI",
      "class_name": "EffectCIWorkflow",
      "name": "effect-ci-github-cloudflare"
    }
  ]
}
