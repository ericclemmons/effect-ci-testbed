---
import { compatibility, environments, checkApp, checkNames, implementationFiles, products } from "../compatibility.mjs"
import { join, posix } from "node:path"
import { existsSync, readdirSync, readFileSync } from "node:fs"
import { getCollection } from "astro:content"
import { documentationId, href, repository } from "../repository.mjs"
import coverage from "../../../../examples/COVERAGE.md?raw"
import { cellResult, validateSnapshot } from "../readiness.mjs"
import readiness from "../../.cloudflare/state/readiness.json"
import { Code } from "./ui/code"
import { TabItem, Tabs } from "./ui/tabs"
const readmes = import.meta.glob("../../../../examples/*/README.md", { query: "?raw", import: "default", eager: true })
// import.meta.glob skips dot-directories, so read implementation sources directly.
const root = [process.cwd(), join(process.cwd(), "../..")].find(dir => existsSync(join(dir, "examples/COVERAGE.md")))!
const sourceDirs = [".github/workflows", ".cloudflare/ci"]
const sources = Object.fromEntries(readdirSync(join(root, "examples"), { withFileTypes: true }).filter(entry => entry.isDirectory())
  .flatMap(entry => sourceDirs.flatMap(dir => {
    const path = join(root, "examples", entry.name, dir)
    return existsSync(path) ? readdirSync(path).filter(file => /\.(ya?ml|ts)$/.test(file)).map(file => `examples/${entry.name}/${dir}/${file}`) : []
  }))
  .map(path => [path, readFileSync(join(root, path), "utf8")]))
const docs = new Set((await getCollection("docs")).map(page => page.id))
const groups = compatibility(coverage, readmes)
function featureHref(link) {
  const [path, fragment] = link.split("#")
  const source = posix.normalize(`examples/${path}`)
  const id = documentationId(source.endsWith(".md") ? source : `${source}/README.md`)
  if (!docs.has(id)) throw new Error(`Missing feature documentation: ${link}`)
  return href(id) + (fragment ? `#${fragment}` : "")
}
const snapshot = validateSnapshot(readiness)
const results = groups.map(group => ({ ...group, rows: group.rows.map(row => ({ ...row,
  results: row.cells.map((applicable, index) => applicable ? cellResult(snapshot, checkNames(row.recipe, environments[index]), checkApp(environments[index])) : undefined),
  files: row.recipe ? implementationFiles(row.recipe, Object.keys(sources)) : { github: [], effect: [] },
})) }))
const rows = results.flatMap(group => group.rows)
const cells = rows.flatMap(row => row.results).filter(Boolean)
const passed = cells.filter(cell => cell.passing).length
const percent = (count, total) => Math.round(count / total * 100)
const environmentCoverage = environments.map((_, index) => rows.filter(row => row.results[index]?.passing).length)
const checkedAt = new Date(snapshot.fetchedAt).toISOString().replace("T", " ").replace(/\.\d+Z$/, " UTC")
const language = (path) => path.endsWith(".yml") ? "yaml" : "ts"
// Second header row: Effect CI spans three environments; GitHub Actions has one.
const environmentLabels = ["", "Local", "GitHub Actions", "Hosted"]
const missing = { github: "No GitHub Actions comparison for this recipe.", effect: "No Effect CI workflow for this recipe." }
---
<section class="readiness" aria-label="Feature readiness" data-readiness>
  <div class="features" aria-label="Feature compatibility on main, grouped by recipe">
    <div class="feature-head" aria-hidden="true">
      <span class="head-feature">Feature</span>
      <span class="head-product" style="grid-column: 2">GitHub Actions</span>
      <span class="head-product head-span" style="grid-column: 3 / span 3">Effect CI</span>
      {environments.map((_, index) => environmentLabels[index] && <span class="environment" style={`grid-column: ${index + 2}; grid-row: 2`}>{environmentLabels[index]}</span>)}
      <a class="overall" href={`${repository}/commit/${snapshot.sha}`} title={`${passed} / ${cells.length} passing on main · ${snapshot.sha.slice(0, 7)} · ${snapshot.total_count} completed checks · ${checkedAt}`}>
        <progress max={cells.length} value={passed}></progress>
        <span class="environment-percent">{percent(passed, cells.length)}%</span>
        <time hidden datetime={snapshot.fetchedAt}>{checkedAt}</time>
      </a>
      {environments.map((_, index) => <span class="environment-percent" style={`grid-column: ${index + 2}; grid-row: 3`}>{percent(environmentCoverage[index], rows.length)}%</span>)}
    </div>
    {rows.map(row => <details class="feature" data-recipe={row.recipe}>
        <summary>
          <span class="feature-title">{row.link ? <a href={featureHref(row.link)}>{row.title}</a> : row.title}</span>
          {row.results.map((result, index) => <span class="cell">
            {result ? <a class="square" data-cell data-passing={result.passing || undefined} data-failing={result.failing || undefined}
              href={result.href} title={`${row.title} · ${environments[index]}: ${result.state}`}
              aria-label={`${row.title} · ${environments[index]}: ${result.state}`}>{result.passing ? "🟢" : result.failing ? "🔴" : "—"}</a> : <span class="square" data-na aria-label={`${row.title} · ${environments[index]}: not applicable`}>—</span>}
          </span>)}
        </summary>
        <div class="compare" data-pagefind-ignore>
          {products.map(product => <div class="implementation" data-product={product.id}>
            <div class="implementation-head">{product.label}</div>
            <Tabs syncKey="effect-ci-files" class="source-tabs">
              {row.files[product.id].length ? row.files[product.id].map(path => <TabItem label={posix.basename(path)}>
                <div class="source">
                  <Code code={sources[`examples/${row.recipe}/${path}`].trimEnd()} lang={language(path)} />
                </div>
              </TabItem>) : <TabItem label="None">
                <p class="missing">{missing[product.id]}</p>
              </TabItem>}
            </Tabs>
          </div>)}
        </div>
      </details>)}
  </div>
</section>
<style>
  :global(#main-content > div:has([data-readiness])) { max-width: min(100%, 110rem); }
  .readiness { margin-bottom: 2.5rem; }
  p { margin: .6rem 0; }
  .head-feature { grid-column: 1; grid-row: 1; }
  .overall { grid-column: 1; grid-row: 3; display: flex; align-items: center; gap: .5rem; max-width: 20rem; text-decoration: none; }
  progress { display: block; flex: 1; height: .375rem; margin: 0; accent-color: #15803d; border: 0; border-radius: .25rem; overflow: hidden; background: var(--nb-border); }
  progress::-webkit-progress-bar { background: var(--nb-border); }
  progress::-webkit-progress-value { background: #15803d; }
  progress::-moz-progress-bar { background: #15803d; }
  a { color: var(--nb-brand); }


  .features { --cells: repeat(4, minmax(3.2rem, 5.5rem)); font-size: .875rem; }
  .feature-head, summary { display: grid; grid-template-columns: minmax(12rem, 1fr) var(--cells); align-items: center; gap: .25rem; min-width: 36rem; }
  .feature-head { grid-template-rows: auto auto auto; row-gap: .2rem; align-items: end; position: sticky; top: var(--nb-header-height, 3.5rem); z-index: 2; background: var(--nb-background, var(--color-background)); border-bottom: 1px solid var(--nb-border); padding: .5rem .3rem; font-size: .7rem; font-weight: 600; line-height: 1.25; }
  .head-product { text-align: center; }
  .head-span { border-bottom: 1px solid var(--nb-border); padding-bottom: .15rem; }
  .environment { text-align: center; }
  .environment-percent { text-align: center; color: var(--nb-muted-foreground); font-weight: 500; }
  .feature { border-bottom: 1px solid var(--nb-border); }
  summary { padding: .45rem .3rem; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: color-mix(in srgb, var(--nb-border) 35%, transparent); }
  .feature-title { display: flex; align-items: center; gap: .45rem; }
  .feature-title::before { content: "▸"; color: var(--nb-muted-foreground); transition: transform .15s; }
  .feature[open] .feature-title::before { transform: rotate(90deg); }
  .cell { display: grid; place-items: center; }
  .square { line-height: 1; display: inline-grid; place-items: center; width: 1.65rem; height: 1.65rem; border-radius: 999px; color: var(--nb-muted-foreground); text-decoration: none; font-size: .9rem; }
  a.square:not([data-passing]):not([data-failing]) { color: var(--nb-foreground); font-weight: 600; }
  a.square:hover, a.square:focus-visible { outline: 2px solid var(--nb-foreground); outline-offset: 3px; }

  .compare { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin: 0 0 .75rem; background: var(--nb-border); border: 1px solid var(--nb-border); }
  .compare::after { content: ""; position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 2px 4px rgb(0 0 0 / .05); }
  .implementation { min-width: 0; display: flex; flex-direction: column; background: var(--nb-card); }
  .implementation-head { padding: .5rem .75rem 0; font-size: .8125rem; font-weight: 500; color: var(--nb-muted-foreground); }
  .implementation :global([data-nb-tabs]) { flex: 1; display: flex; flex-direction: column; min-height: 0; }
  .implementation :global([data-nb-tabs-list]) { padding-inline: .25rem; }
  .implementation :global([data-nb-tabs] > .mt-3) { flex: 1; display: flex; flex-direction: column; margin-top: 0; }
  .implementation :global([data-nb-tabs-content]:not([hidden])) { flex: 1; display: flex; flex-direction: column; }
  .source { flex: 1; display: flex; flex-direction: column; }
  .source :global(figure) { flex: 1; display: flex; flex-direction: column; margin: 0; border: 0; border-radius: 0; background: transparent; }
  .source :global(pre) { flex: 1; max-height: 32rem; overflow: auto; font-size: .75rem; line-height: 1.5; margin: 0; border: 0; border-radius: 0; }
  .source :global(pre .line) { display: inline; }
  .source :global(.nb-code-figure::before) { display: none; }
  .missing { color: var(--nb-muted-foreground); font-style: italic; margin: 0; padding: .75rem; }
  @media (max-width: 48rem) { .features { overflow-x: auto; } .compare { grid-template-columns: minmax(0, 1fr); } }
</style>
