  },
  "devDependencies": {
    "@e2e-dev/web": "0.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "e2e": "0.19.0",
    "vite-plus": "1.0.0",
    "ws": "8.21.0"
  }
