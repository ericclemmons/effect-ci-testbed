{
  "name": "@effect-ci-testbed/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/snapshot.mjs && astro dev --host 127.0.0.1",
    "build": "node scripts/snapshot.mjs && astro build && node --test scripts/*.test.mjs && node scripts/build-output.mjs",
    "check": "pnpm run build",
    "preview": "astro preview --host 127.0.0.1",
    "deploy": "pnpm run build && cf deploy --prebuilt"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@cloudflare/build-output-utils": "0.8.5",
    "@cloudflare/nimbus-docs": "0.19.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@iconify-json/ph": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.4",
    "astro": "7.4.2",
    "cf": "1.0.0-beta.12",
    "clsx": "^2.1.1",
    "mermaid": "^11.0.0",
    "pagefind": "^1.5.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.4",
    "unified": "^11.0.5"
  }
}
