# Public immutable bases; no private registry or host credentials needed.
FROM node:24.22.0-trixie-slim@sha256:7f486cabe892bff8fef04c0f7da8dba84a560be3e4e2740b7a86afc57ebec315

RUN apt-get update \
  && apt-get install --yes --no-install-recommends bash ca-certificates curl git python3 \
  && rm -rf /var/lib/apt/lists/*

RUN npm install --global pnpm@12.8.1 --ignore-scripts --fetch-retries=1 --fetch-timeout=30000

# Prepared from locked production packages by the Vite build.
# Root-owned runtime is separate from the project-writable checkout.
COPY .standalone-runtime /opt/effect-ci

COPY --from=docker.io/cloudflare/sandbox:1.0.0@sha256:5bc187515bad0d9d486a4f1476f7d8ad39fe97c57965f044e4b0a0dcc93eac06 \
  /usr/local/bin/sandbox-shim /usr/local/bin/sandbox-shim

RUN mkdir -p /workspace && chown node:node /workspace

# CI.Toolchain.Node and CI.Toolchain.Mise run Mise. Last layer, so a version
# bump reuses everything above; the same pinned release local recipes use.
COPY --from=ghcr.io/jdx/mise:2026.9.11-debian@sha256:12f3fe18fe6c02c54d1bbb9bdc60a492a72a320252439f0df657c6f01a04c23f \
  /usr/local/bin/mise /usr/local/bin/mise
ENV HOME=/home/node
USER node
# The installed vp hands `vp run` to each project's own vite-plus (an npm-installed vp
# does not). Node.js and package managers stay the image's and the project's.
RUN curl -fsSL -o /tmp/install-vp.sh https://vite.plus \
  && CI=1 VP_VERSION=1.6.0 VP_HOME=/home/node/.vite-plus VP_NODE_MANAGER=no VP_PM_MANAGER=no bash /tmp/install-vp.sh \
  && rm /tmp/install-vp.sh && /home/node/.vite-plus/bin/vp --version
ENV PATH=/home/node/.vite-plus/bin:$PATH
WORKDIR /workspace
CMD ["sleep", "infinity"]
