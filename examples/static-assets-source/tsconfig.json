  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "allowImportingTsExtensions": true, "strict": true, "noEmit": true,
    "skipLibCheck": true, "types": ["@cloudflare/workers-types", "node"]
