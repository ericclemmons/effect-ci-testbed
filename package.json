{
  "name": "effect-ci-testbed",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "pnpm --filter @effect-ci-testbed/ci build",
    "check": "pnpm --filter './packages/*' check && tsc -p examples/node-npm/tsconfig.json --noEmit && tsc -p examples/node-pnpm/tsconfig.json --noEmit && tsc -p examples/hitl-deploy/tsconfig.json --noEmit && tsc -p examples/cloudflare-runner/tsconfig.json --noEmit && tsc -p examples/cloudflare-toolchain/tsconfig.json --noEmit && tsc -p examples/github-cloudflare-ci/tsconfig.json --noEmit && tsc -p examples/vite-plus-cache/tsconfig.json --noEmit && tsc -p examples/turborepo-cache/tsconfig.json --noEmit",
    "ci:hitl-deploy": "EFFECT_CI_APPROVAL=approved EFFECT_CI_EVENT=workflow_dispatch EFFECT_CI_WORKFLOW=examples/hitl-deploy/.cloudflare/workflows/deploy.ts tsx packages/ci/run.run.ts",
    "ci:hitl-deploy:dry-run": "DRY_RUN=1 pnpm ci:hitl-deploy",
    "ci:cloudflare-runner": "EFFECT_CI_EVENT=workflow_dispatch EFFECT_CI_WORKFLOW=examples/cloudflare-runner/.cloudflare/workflows/build.ts tsx packages/ci/run.run.ts",
    "ci:cloudflare-runner:dry-run": "DRY_RUN=1 pnpm ci:cloudflare-runner",
    "ci:node-npm": "examples/node-npm/.cloudflare/workflows/ci.run.ts --format=text",
    "ci:node-npm:dry-run": "examples/node-npm/.cloudflare/workflows/ci.run.ts plan --format=text",
    "ci:node-pnpm": "examples/node-pnpm/.cloudflare/workflows/ci.run.ts --format=text",
    "ci:node-pnpm:dry-run": "examples/node-pnpm/.cloudflare/workflows/ci.run.ts plan --format=text"
  },
  "devDependencies": {
    "@effect-ci-testbed/ci": "workspace:*",
    "@effect-ci-testbed/cli": "workspace:*",
    "@types/node": "^26.6.3",
    "effect": "4.0.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
