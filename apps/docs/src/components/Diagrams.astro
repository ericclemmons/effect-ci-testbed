<style is:global>
  .docs-content textarea {
    display: block;
    width: 100%;
    padding: 1rem;
    border: 1px solid var(--nb-border);
    border-radius: 0.5rem;
    background: var(--nb-background);
    color: var(--nb-foreground);
    font: inherit;
    resize: vertical;
  }
</style>
<script>
  async function diagrams() {
    const nodes = document.querySelectorAll<HTMLElement>("pre.mermaid:not([data-processed])")
    if (!nodes.length) return
    const { default: mermaid } = await import("mermaid")
    mermaid.initialize({ startOnLoad: false, securityLevel: "strict", theme: document.documentElement.dataset.mode === "dark" ? "dark" : "default" })
    await mermaid.run({ nodes: Array.from(nodes) })
  }
  diagrams()
  document.addEventListener("astro:page-load", diagrams)
</script>
