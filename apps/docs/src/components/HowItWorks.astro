---
import { agents, app, appHealth, checkMark, createFactory, github, githubText, humans, poolStats, runText, runner, runnerStats, team, tokenize, view, wires } from "../factory.mjs"
// Render a moment of the stream into the HTML; the client replays to the same moment and continues.
const snapshotAt = 26000
const factory = createFactory()
factory.advance(snapshotAt)
const { state } = factory
const box = ({ x, y, w, h }: { x: number, y: number, w: number, h: number }) =>
  `left:${(x / view.width) * 100}%;top:${(y / view.height) * 100}%;width:${(w / view.width) * 100}%;height:${(h / view.height) * 100}%`
const tabs = [["me", "You"], ["teammate", "Teammate"], ["a1", "Agent 1"], ["a2", "Agent 2"], ["a3", "Agent 3"], ["github", "GitHub"], ["runner", "Runner"], ["app", "dash"]]
const lines = 12
const legend = [["source", "commit"], ["pr", "pull request"], ["review", "review"], ["pass", "check"], ["deploy", "deploy"], ["error", "error event"], ["dispatch", "agent dispatch"]]
const pools = [["worker", "Workers", "lint · format · verify · ms startup"], ["container", "Containers", "build · test · deploy"]]
const slots = state.slots.map((slot, index) => ({ ...slot, index }))
const stages = [
  { n: 1, title: "Describe", body: "Start from package scripts, or write a typed ci.ts graph.", code: "ci.ts" },
  { n: 2, title: "Inspect", body: "Humans and agents see the same plan before anything runs.", code: "effect-ci plan" },
  { n: 3, title: "Run anywhere", body: "The same graph runs on your machine, GitHub Actions, or a Cloudflare host.", code: "effect-ci run" },
  { n: 4, title: "Reuse and report", body: "Cache hits replay, unchanged work is skipped, and checks report back.", code: "gh pr checks" },
]
const line = (text: string) => tokenize(text)
---
<section class="hiw" aria-labelledby="how-it-works" data-hiw>
  <p class="lead">One CI graph you can inspect, run locally, and then run unchanged on a host. It skips work that a change cannot affect.</p>
  <div class="cta">
    <a class="primary" href="/walkthrough/">Start the walkthrough</a>
    <a href="/examples/features/">See every feature</a>
  </div>

  <h2 id="how-it-works">How it works</h2>
  <ol class="stages">
    {stages.map(stage => <li><span class="n">{stage.n}</span><strong>{stage.title}</strong><span>{stage.body}</span><code>{stage.code}</code></li>)}
  </ol>

  <div class="factory" data-factory data-snapshot={snapshotAt} data-lines={lines}>
    <div class="scroller">
      <div class="stage" role="group" aria-label="A team of people each work through agents. Agents run checks locally, then have the hosted runner check and sign each commit before they open a pull request on GitHub. People review and merge; main reuses the signed checks and only deploys to dash.cloudflare.com. Errors there dispatch an agent, which opens a fix for review." data-stage>
        <div class="team" style={box(team)}><span>Team</span></div>
        <svg viewBox={`0 0 ${view.width} ${view.height}`} aria-hidden="true">
          {Object.entries(wires).map(([id, wire]) => <Fragment>
            <path class="wire" d={wire.d} data-wire={id} data-tone={wire.tone} />
            {wire.label && <text class="wire-label" x={wire.lx} y={wire.ly} data-tone={wire.tone}>{wire.label}</text>}
          </Fragment>)}
          <g data-packets></g>
        </svg>

        {Object.entries(humans).map(([id, human]) => <div class="node human" data-node={id} data-tone={state.humans[id].tone} tabindex="0" style={box(human)} aria-label={human.label}>
          <span class="avatar">{human.label[0]}</span>
          <span class="who"><strong>{human.label}</strong><span class="status" data-status>{state.humans[id].status}</span></span>
        </div>)}

        {Object.entries(agents).map(([id, agent]) => <div class="node agent" data-node={id} data-tone={state.agents[id].tone} tabindex="0" style={box(agent)} aria-label={`${agent.label}, ${agent.tag}`}>
          <div class="head"><span class="avatar">✦</span><strong>{agent.label}</strong><span class="tag">{agent.tag}</span><code data-sha>{state.agents[id].sha}</code></div>
          <div class="status" data-status>{state.agents[id].status}</div>
          <div class="bar"><i data-progress></i></div>
        </div>)}

        <div class="node remote" data-node="github" data-check={state.github.check} tabindex="0" style={box(github)} aria-label="GitHub, the source of truth">
          <strong>{github.label}</strong>
          <span class="ref" data-ref>{githubText(state.github)}</span>
          <span class="mark" data-mark>{checkMark(state.github.check)}</span>
        </div>

        <div class="node runner" data-node="runner" tabindex="0" style={box(runner)} aria-label="Hosted runner on Cloudflare">
          <div class="head"><strong>{runner.label}</strong><span class="role">{runner.role}</span><span class="stats" data-stats>{runnerStats(state)}</span></div>
          {pools.map(([pool, label, note]) => <div class="pool" data-pool={pool}>
            <div class="pool-head"><strong>{label}</strong><span>{note}</span><span class="stats" data-pool-stats={pool}>{poolStats(state, pool)}</span></div>
            <div class="slots">
              {slots.filter(slot => slot.pool === pool).map(slot => <div class="slot" data-node={`slot-${slot.index}`} data-state={slot.state} data-warm={String(slot.warm)} tabindex="0" aria-label={`${label} slot`}>
                <span class="task" data-task>{slot.task || "·"}</span>
                <span class="sha" data-sha>{slot.sha}</span>
                <i data-progress></i>
              </div>)}
            </div>
          </div>)}
          <ol class="runs" data-runs>
            {state.runs.map(run => <li data-status={run.status}><span>{run.id}</span><span>{run.ref} {run.sha}</span><span>{runText(run)}</span></li>)}
          </ol>
        </div>

        <div class="node app" data-node="app" data-health={state.app.incidents.length ? "error" : "ok"} tabindex="0" style={box(app)} aria-label="dash.cloudflare.com in production">
          <div class="chrome"><i></i><i></i><i></i><span>{app.label}</span></div>
          <div class="body">
            <div class="row"><strong data-version>v{state.app.version}</strong> <code data-sha>{state.app.sha}</code></div>
            <span class="health" data-health-text>{appHealth(state.app)}</span>
            <div class="spark" data-spark>{state.app.bars.map(bar => <i data-error={String(bar.error)} style={`transform:scaleY(${bar.h})`}></i>)}</div>
          </div>
        </div>
      </div>
    </div>
    <div class="below">
      <ul class="legend" aria-label="Legend">
        {legend.map(([kind, label]) => <li><i data-kind={kind}></i>{label}</li>)}
      </ul>
      <button type="button" class="toggle" data-toggle hidden aria-pressed="false">Pause</button>
    </div>
    <div class="terminal">
      <div class="tabs">
        <div role="tablist" aria-label="Terminals">
          {tabs.map(([id, label]) => <button type="button" role="tab" data-tab={id} aria-selected={String(id === "a1")} aria-controls="factory-log">{label}</button>)}
          <button type="button" role="tab" data-tab="slot" aria-selected="false" aria-controls="factory-log" disabled title="Hover a Worker or Container">slot</button>
        </div>
      </div>
      <pre id="factory-log" role="tabpanel" data-log>{(state.logs.a1 ?? []).slice(-lines).map(text => <span class="line">{line(text).map(([kind, value]) => kind ? <span class={`t-${kind}`}>{value}</span> : value)}</span>)}</pre>
    </div>
  </div>
</section>

<script>
  import { mount } from "@cloudflare/nimbus-docs/client"
  import { appHealth, checkMark, createFactory, githubText, poolStats, runText, runnerStats, slotIds, slotName, tokenize } from "../factory.mjs"

  const svg = "http://www.w3.org/2000/svg"

  mount("[data-factory]", (root) => {
    const factory = createFactory()
    factory.advance(Number(root.dataset.snapshot))
    const { state } = factory
    const $ = <T extends Element>(selector: string, scope: ParentNode = root) => scope.querySelector<T>(selector)!
    const nodes = new Map([...root.querySelectorAll<HTMLElement>("[data-stage] [data-node]")].map(element => [element.dataset.node!, element]))
    const node = (id: string) => nodes.get(id)!
    const paths = Object.fromEntries([...root.querySelectorAll<SVGPathElement>("[data-wire]")].map(path => [path.dataset.wire!, { path, length: path.getTotalLength() }]))
    const layer = $<SVGGElement>("[data-packets]")
    const log = $<HTMLElement>("[data-log]")
    const slotTab = $<HTMLButtonElement>('[data-tab="slot"]')
    const lines = Number(root.dataset.lines)
    const toggle = $<HTMLButtonElement>("[data-toggle]")
    const packets = new Map<number, { group: SVGGElement, head: SVGGElement, trail: SVGPathElement }>()
    const bars = new Map<string, { element: HTMLElement, value: number }>()
    for (const id of [...Object.keys(state.agents), ...slotIds()]) bars.set(id, { element: $<HTMLElement>("[data-progress]", node(id)), value: -1 })
    const setBar = (id: string, value: number) => {
      const bar = bars.get(id)!
      const rounded = Math.round(value * 200) / 200
      if (bar.value !== rounded) { bar.value = rounded; bar.element.style.transform = `scaleX(${rounded})` }
    }
    let runsKey = ""
    let selected = "a1"
    let paused = matchMedia("(prefers-reduced-motion: reduce)").matches
    let visible = true
    let frame = 0
    let last = 0

    const text = (element: Element, value: string) => { if (element.textContent !== value) element.textContent = value }

    function render(id: string) {
      if (id in state.humans) {
        const human = state.humans[id as keyof typeof state.humans], element = node(id)
        element.dataset.tone = human.tone
        text($("[data-status]", element), human.status)
      } else if (id in state.agents) {
        const agent = state.agents[id as keyof typeof state.agents], element = node(id)
        element.dataset.tone = agent.tone
        text($("[data-status]", element), agent.status)
        text($("[data-sha]", element), agent.sha)
      } else if (id === "github") {
        const element = node(id)
        element.dataset.check = state.github.check
        text($("[data-ref]", element), githubText(state.github))
        text($("[data-mark]", element), checkMark(state.github.check))
      } else if (id.startsWith("slot-")) {
        const slot = state.slots[Number(id.slice(5))], element = node(id)
        element.dataset.state = slot.state
        element.dataset.warm = String(slot.warm)
        text($("[data-task]", element), slot.task || "·")
        text($("[data-sha]", element), slot.sha)
      } else if (id === "runner") {
        text($("[data-stats]"), runnerStats(state))
        for (const pool of ["worker", "container"]) text($(`[data-pool-stats="${pool}"]`), poolStats(state, pool))
        const key = state.runs.map(run => `${run.id}${run.status}${run.done}`).join()
        if (key === runsKey) return
        runsKey = key
        $("[data-runs]").replaceChildren(...state.runs.map(run => {
          const item = document.createElement("li")
          item.dataset.status = run.status
          for (const value of [run.id, `${run.ref} ${run.sha}`, runText(run)]) item.append(Object.assign(document.createElement("span"), { textContent: value }))
          return item
        }))
      } else if (id === "app") {
        const element = node("app")
        element.dataset.health = state.app.incidents.length ? "error" : "ok"
        text($("[data-version]", element), `v${state.app.version}`)
        text($("[data-sha]", element), state.app.sha)
        text($("[data-health-text]", element), appHealth(state.app))
        ;[...$("[data-spark]", element).children].forEach((bar, index) => {
          const { h, error } = state.app.bars[index]
          ;(bar as HTMLElement).style.transform = `scaleY(${h})`
          ;(bar as HTMLElement).dataset.error = String(error)
        })
      } else if (id === "packets") syncPackets()
    }

    function syncPackets() {
      const live = new Set(state.packets.map(packet => packet.id))
      for (const [id, view] of packets) if (!live.has(id)) { view.group.remove(); packets.delete(id) }
      for (const packet of state.packets) {
        if (packets.has(packet.id)) continue
        const group = document.createElementNS(svg, "g")
        group.setAttribute("class", "packet")
        group.dataset.kind = packet.kind
        const trail = document.createElementNS(svg, "path")
        trail.setAttribute("class", "trail")
        trail.setAttribute("d", paths[packet.wire].path.getAttribute("d")!)
        const head = document.createElementNS(svg, "g")
        const dot = document.createElementNS(svg, "circle")
        dot.setAttribute("r", packet.kind === "dispatch" || packet.kind === "error" ? "7" : "6")
        const label = document.createElementNS(svg, "text")
        label.setAttribute("x", "10")
        label.setAttribute("y", "-8")
        label.textContent = packet.label
        head.append(dot, label)
        group.append(trail, head)
        layer.append(group)
        packets.set(packet.id, { group, head, trail })
      }
      for (const [id, { path }] of Object.entries(paths)) path.toggleAttribute("data-hot", state.packets.some(packet => packet.wire === id))
    }

    function animate() {
      for (const packet of state.packets) {
        const view = packets.get(packet.id)
        if (!view) continue
        const { path, length } = paths[packet.wire]
        const progress = Math.min(1, (state.now - packet.start) / packet.duration)
        const at = packet.reverse ? length * (1 - progress) : length * progress
        const point = path.getPointAtLength(at)
        view.head.setAttribute("transform", `translate(${point.x} ${point.y})`)
        const tail = Math.min(70, length * progress)
        view.trail.style.strokeDasharray = `${tail} ${length + 80}`
        view.trail.style.strokeDashoffset = String(packet.reverse ? -at : tail - at)
      }
      for (const [id, agent] of Object.entries(state.agents)) setBar(id, agent.progress ? Math.min(1, (state.now - agent.progress.start) / agent.progress.duration) : 0)
      state.slots.forEach((slot, index) => {
        const active = slot.state === "run" || slot.state === "boot"
        setBar(`slot-${index}`, active ? Math.min(1, (state.now - slot.start) / slot.duration) : slot.state === "idle" ? 0 : 1)
      })
    }

    function flush() {
      const changed = factory.drain()
      changed.forEach(render)
      if (changed.has(selected)) showLog()
    }

    function loop(time: number) {
      frame = 0
      if (paused || !visible) return
      factory.tick(last ? Math.min(100, time - last) : 16)
      last = time
      flush()
      animate()
      frame = requestAnimationFrame(loop)
    }
    const start = () => { if (!frame && !paused && visible) { last = 0; frame = requestAnimationFrame(loop) } }
    const stop = () => { cancelAnimationFrame(frame); frame = 0 }

    function showLog() {
      const history = state.logs[selected] ?? []
      log.replaceChildren(...(history.length ? history.slice(-lines) : ["idle · waiting for work"]).map(line => {
        const row = document.createElement("span")
        row.className = "line"
        for (const [kind, value] of tokenize(line)) row.append(kind ? Object.assign(document.createElement("span"), { className: `t-${kind}`, textContent: value }) : value)
        return row
      }))
    }

    function select(id: string | undefined) {
      if (!id || id === selected) return
      node(selected)?.removeAttribute("data-selected")
      selected = id
      node(id)?.setAttribute("data-selected", "")
      const slot = id.startsWith("slot-")
      if (slot) {
        slotTab.dataset.slot = id
        slotTab.disabled = false
        slotTab.textContent = slotName(state, id)
      }
      root.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach(tab => tab.setAttribute("aria-selected", String(tab.dataset.tab === id || (slot && tab === slotTab))))
      showLog()
    }

    // Full sync from the replayed state, then start streaming.
    for (const id of [...Object.keys(state.humans), ...Object.keys(state.agents), "github", ...slotIds(), "runner", "app", "packets"]) render(id)
    factory.drain()
    node(selected).setAttribute("data-selected", "")
    showLog()
    animate()
    toggle.hidden = false
    const syncToggle = () => { toggle.textContent = paused ? "Play" : "Pause"; toggle.setAttribute("aria-pressed", String(paused)) }
    syncToggle()

    const controller = new AbortController()
    const { signal } = controller
    toggle.addEventListener("click", () => { paused = !paused; syncToggle(); paused ? stop() : start() }, { signal })
    const target = (event: Event) => (event.target as Element).closest<HTMLElement>("[data-stage] [data-node]")?.dataset.node
    root.addEventListener("pointerover", event => select(target(event)), { signal })
    root.addEventListener("focusin", event => select(target(event)), { signal })
    root.addEventListener("click", event => {
      const tab = (event.target as Element).closest<HTMLButtonElement>("[data-tab]")
      if (tab) select(tab === slotTab ? tab.dataset.slot : tab.dataset.tab)
    }, { signal })
    const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; visible ? start() : stop() })
    observer.observe(root)
    start()

    return () => { controller.abort(); observer.disconnect(); stop() }
  })
</script>

<style>
  .hiw { margin-bottom: 2.5rem; }
  .lead { font-size: 1.15rem; line-height: 1.6; color: var(--nb-foreground); text-wrap: pretty; margin: 0 0 1rem; }
  .cta { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 2.25rem; }
  .cta a { padding: .5rem .9rem; border-radius: var(--nb-radius); border: 1px solid var(--nb-border-strong); color: var(--nb-foreground); text-decoration: none; font-weight: 500; font-size: .9rem; }
  .cta a.primary { background: var(--nb-primary); color: var(--nb-primary-foreground); border-color: var(--nb-primary); }
  .cta a:hover { border-color: var(--nb-foreground); }
  h2 { margin: 0 0 1rem; font-size: 1.7rem; line-height: 1.2; color: var(--nb-foreground); }

  .stages { list-style: none; padding: 0; margin: 0 0 1.25rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .6rem; counter-reset: none; }
  .stages li { display: flex; flex-direction: column; gap: .3rem; padding: .8rem; border: 1px solid var(--nb-border); border-radius: var(--nb-radius); background: var(--nb-card); font-size: .82rem; line-height: 1.4; color: var(--nb-muted-foreground); margin: 0; position: relative; }
  .stages li + li::before { content: "→"; position: absolute; left: -.55rem; top: .9rem; color: var(--nb-muted-foreground); background: var(--nb-background); font-size: .8rem; line-height: 1; }
  .stages strong { color: var(--nb-foreground); font-size: .92rem; }
  .stages code { margin-top: auto; align-self: flex-start; font-size: .72rem; }
  .n { display: inline-grid; place-items: center; width: 1.35rem; height: 1.35rem; border-radius: 999px; background: var(--nb-brand-wash); color: var(--nb-brand); font-weight: 700; font-size: .72rem; }

  /* Packet and state colors. */
  .factory {
    --k-source: var(--nb-foreground); --k-cached: var(--nb-info); --k-docs: var(--nb-muted-foreground);
    --k-pass: var(--nb-success); --k-fail: var(--nb-danger); --k-skip: var(--nb-muted-foreground);
    --k-deploy: oklch(0.7 0.18 50); --k-error: var(--nb-danger); --k-dispatch: oklch(0.6 0.2 300);
    --k-pr: var(--nb-info); --k-review: oklch(0.72 0.15 85);
    position: relative; border: 1px solid var(--nb-border); border-radius: calc(var(--nb-radius) * 1.5); background: var(--nb-card); padding: 1rem; box-shadow: var(--nb-shadow-sm);
  }
  button:focus-visible, .node:focus-visible { outline: 2px solid var(--nb-ring); outline-offset: 2px; }

  .scroller { overflow-x: auto; }
  .stage { position: relative; container-type: inline-size; aspect-ratio: 1000 / 860; min-width: 34rem; }
  .stage svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .wire { fill: none; stroke: var(--nb-border-strong); stroke-width: 2; transition: stroke .3s; }
  .wire[data-tone] { stroke-dasharray: 5 5; }
  .wire[data-hot] { stroke: color-mix(in oklch, var(--nb-foreground) 45%, var(--nb-border-strong)); }
  .wire-label { font-family: var(--nb-font-mono); font-size: 15px; fill: var(--nb-muted-foreground); }
  .wire-label[data-tone="danger"] { fill: var(--nb-danger); }
  .wire-label[data-tone="agent"] { fill: var(--k-dispatch); }
  :global(.packet) { --k: var(--k-source); }
  :global(.packet[data-kind="cached"]) { --k: var(--k-cached); }
  :global(.packet[data-kind="docs"]), :global(.packet[data-kind="skip"]) { --k: var(--k-docs); }
  :global(.packet[data-kind="pass"]) { --k: var(--k-pass); }
  :global(.packet[data-kind="fail"]), :global(.packet[data-kind="error"]) { --k: var(--k-error); }
  :global(.packet[data-kind="deploy"]) { --k: var(--k-deploy); }
  :global(.packet[data-kind="dispatch"]) { --k: var(--k-dispatch); }
  :global(.packet[data-kind="pr"]) { --k: var(--k-pr); }
  :global(.packet[data-kind="review"]) { --k: var(--k-review); }
  :global(.packet[data-kind="merge"]) { --k: var(--k-pass); }
  :global(.packet .trail) { fill: none; stroke: var(--k); stroke-width: 4; stroke-linecap: round; opacity: .55; }
  :global(.packet circle) { fill: var(--k); stroke: var(--nb-card); stroke-width: 2; }
  :global(.packet[data-kind="docs"] circle), :global(.packet[data-kind="skip"] circle) { fill: var(--nb-card); stroke: var(--k); stroke-dasharray: 3 2; }
  :global(.packet[data-kind="docs"] .trail), :global(.packet[data-kind="skip"] .trail) { stroke-width: 2; }
  :global(.packet text) { font-family: var(--nb-font-mono); font-size: 17px; font-weight: 600; fill: var(--k); paint-order: stroke; stroke: var(--nb-card); stroke-width: 4px; }

  .node { position: absolute; box-sizing: border-box; border: 1.5px solid var(--nb-border-strong); border-radius: 1cqw; background: var(--nb-background); color: var(--nb-foreground); font-size: 2cqw; line-height: 1.3; cursor: default; transition: border-color .25s, background-color .25s, box-shadow .25s; }
  .node:hover { box-shadow: 0 0 0 .3cqw color-mix(in oklch, var(--nb-foreground) 12%, transparent); }
  .role, .stats { font-family: var(--nb-font-mono); font-size: 1.5cqw; color: var(--nb-muted-foreground); text-transform: uppercase; letter-spacing: .06em; }
  .stage code { font-size: 1.6cqw; }

  .team { position: absolute; box-sizing: border-box; border: 1.5px dashed var(--nb-border-strong); border-radius: 1.4cqw; background: color-mix(in oklch, var(--k-dispatch) 3%, transparent); }
  .team span { position: absolute; bottom: 1.2cqw; left: 0; right: 0; text-align: center; font-family: var(--nb-font-mono); font-size: 1.4cqw; text-transform: uppercase; letter-spacing: .12em; color: var(--nb-muted-foreground); }
  .avatar { flex: none; display: inline-grid; place-items: center; width: 3.2cqw; height: 3.2cqw; border-radius: 999px; background: var(--nb-brand-wash); color: var(--nb-brand); font-weight: 700; font-size: 1.7cqw; }
  .human { display: flex; align-items: center; gap: 1cqw; padding: 0 1.4cqw; white-space: nowrap; }
  .who { display: flex; flex-direction: column; min-width: 0; line-height: 1.2; }
  .human strong { font-size: 1.9cqw; }
  .human .status { overflow: hidden; text-overflow: ellipsis; font-family: var(--nb-font-mono); font-size: 1.45cqw; color: var(--nb-muted-foreground); }
  .human[data-tone="edit"] { border-color: var(--nb-info); }
  .human[data-tone="review"] { border-color: var(--k-review); background: color-mix(in oklch, var(--k-review) 10%, var(--nb-background)); } .human[data-tone="review"] .status { color: var(--nb-foreground); }
