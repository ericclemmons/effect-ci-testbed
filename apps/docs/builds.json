{
  "provider": "GitHub Actions",
  "workflow": ".github/workflows/docs.yml",
  "worker": "effect-ci-docs",
  "url": "https://effect-ci-docs.eclemmons.workers.dev",
  "legacyWorkersBuilds": {
    "triggerId": "5fb6ee0f-146b-47bd-b360-a5357934c0f7",
    "branch_includes": ["codex/docs-builds-disabled"],
    "branch_excludes": []
  },
  "branch": "main",
  "rootDirectory": "/",
  "buildCommand": "pnpm docs:build",
  "deployCommand": "pnpm --filter @effect-ci-testbed/docs exec cf deploy --prebuilt",
  "environment": {
    "NODE_VERSION": "24",
    "PNPM_VERSION": "12.8.1"
  }
}
