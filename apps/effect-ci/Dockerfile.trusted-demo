# Same pinned runtime as the existing host, with no project write access to OS tools.
FROM registry.cloudflare.com/0db135ec469e2f216fcea26426f29755/cloudflare-build/13fd7ac27c05/effect-ci-workspace-workspace@sha256:7b2ede4459d6738f1465db630f3fe3794fd9c9ba28f8b5a9dffc3900b8df9924

RUN chown node:node /workspace
USER node
WORKDIR /workspace
