{
  "name": "@effect-ci-testbed/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "bin": {
    "effect-ci": "./src/effect-ci.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "@effect-ci-testbed/ci": "workspace:*",
    "@effect-ci-testbed/cloudflare-dynamic-worker": "workspace:*",
    "@vercel/detect-agent": "1.2.5",
    "effect": "4.0.0-beta.19"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
