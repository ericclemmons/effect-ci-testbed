---
import { approvals, changes, defaults, runners, scenario, steps } from "../explainer.mjs"
const initial = scenario(defaults)
const marks = { passed: "✓", cached: "◉", skipped: "—", waiting: "⏸", failed: "×" }
const stages = [
  { n: 1, title: "Describe", body: "Start from package scripts, or write a typed ci.ts graph.", code: "ci.ts" },
  { n: 2, title: "Inspect", body: "Humans and agents see the same plan before anything runs.", code: "effect-ci plan" },
  { n: 3, title: "Run anywhere", body: "The same graph runs on your machine, GitHub Actions, or a Cloudflare host.", code: "effect-ci run" },
  { n: 4, title: "Reuse and report", body: "Cache hits replay, unchanged work is skipped, and checks report back.", code: "gh pr checks" },
]
---
<section class="hiw" aria-labelledby="how-it-works" data-hiw>
  <p class="lead">One CI graph you can inspect, run locally, and then run unchanged on a host. It skips work that a change cannot affect.</p>
  <div class="cta">
    <a class="primary" href="/walkthrough/">Start the walkthrough</a>
    <a href="/examples/features/">See every feature</a>
  </div>

  <h2 id="how-it-works">How it works</h2>
  <ol class="stages">
    {stages.map(stage => <li><span class="n">{stage.n}</span><strong>{stage.title}</strong><span>{stage.body}</span><code>{stage.code}</code></li>)}
  </ol>

  <div class="sim" data-sim data-runner={defaults.runner} data-change={defaults.change} data-approval={defaults.approval}>
    <div class="controls" data-controls hidden>
      <fieldset>
        <legend>Run on</legend>
        {Object.entries(runners).map(([id, runner]) => <button type="button" data-set="runner" data-value={id} aria-pressed={String(id === defaults.runner)}>{runner.label}</button>)}
      </fieldset>
      <fieldset>
        <legend>Then change</legend>
        {Object.entries(changes).map(([id, change]) => <button type="button" data-set="change" data-value={id} aria-pressed={String(id === defaults.change)}><code>{change.label}</code></button>)}
      </fieldset>
    </div>

    <div class="stage" role="img" aria-label="CI graph: ci.ts plans checkout, install, build and publish, then reports a check" data-stage>
      <div class="chip source"><span class="kicker">input</span>ci.ts</div>
      <span class="edge" data-edge></span>
      <div class="runner">
        <span class="runner-label" data-runner-label>{runners[defaults.runner].label}</span>
        <div class="graph">
          {steps.map((step, index) => <Fragment>
            {index > 0 && <span class="edge" data-edge></span>}
            <div class="node" data-node={step.id} data-state={initial.nodes[step.id].state}>
              <span class="mark" data-mark>{marks[initial.nodes[step.id].state]}</span>
              <span class="name">{step.label}</span>
              <span class="note" data-note>{initial.nodes[step.id].note}</span>
            </div>
          </Fragment>)}
        </div>
      </div>
      <span class="edge" data-edge></span>
      <div class="chip check" data-check={initial.check}><span class="kicker">reports</span>check</div>
    </div>

    <div class="gate" data-gate hidden={!initial.gate}>
      <span>Publish the walkthrough?</span>
      {Object.entries(approvals).filter(([id]) => id !== "pending").map(([id, approval]) => <button type="button" data-set="approval" data-value={id} hidden>{approval.label}</button>)}
      <button type="button" data-set="approval" data-value="pending" data-reset hidden>Reset</button>
    </div>

    <p class="summary" data-summary aria-live="polite">{initial.summary}</p>
    <pre class="terminal" data-terminal aria-label="Terminal output">{initial.lines.join("\n")}</pre>
    <p class="fine">Output excerpted from the <a href="/walkthrough/">walkthrough</a>. Approval and the publication receipt run locally today; hosted runs build and report checks.</p>
  </div>
</section>

<script>
  import { mount } from "@cloudflare/nimbus-docs/client"
  import { runners, scenario } from "../explainer.mjs"

  const marks: Record<string, string> = { passed: "✓", cached: "◉", skipped: "—", waiting: "⏸", failed: "×" }

  mount("[data-sim]", (root) => {
    const controller = new AbortController()
    const timers: number[] = []
    const reduced = () => matchMedia("(prefers-reduced-motion: reduce)").matches
    const $ = <T extends Element>(selector: string) => root.querySelector<T>(selector)!
    const $$ = <T extends Element>(selector: string) => [...root.querySelectorAll<T>(selector)]
    const nodes = $$<HTMLElement>("[data-node]")
    const edges = $$<HTMLElement>("[data-edge]")

    const syncGate = () => $$<HTMLButtonElement>("[data-gate] [data-value]").forEach(button => {
      button.hidden = button.hasAttribute("data-reset") ? root.dataset.approval === "pending" : root.dataset.approval !== "pending"
    })
    $("[data-controls]").hidden = false
    syncGate()

    function render() {
      timers.splice(0).forEach(clearTimeout)
      const state = { runner: root.dataset.runner, change: root.dataset.change, approval: root.dataset.approval } as Parameters<typeof scenario>[0]
      const result = scenario(state)
      $$<HTMLButtonElement>("[data-set]").forEach(button => {
        if (button.dataset.set !== "approval") button.setAttribute("aria-pressed", String(root.dataset[button.dataset.set!] === button.dataset.value))
      })
      syncGate()
      $("[data-runner-label]").textContent = runners[state!.runner as keyof typeof runners].label
      $("[data-gate]").hidden = !result.gate
      $("[data-summary]").textContent = result.summary
      const terminal = $("[data-terminal]")
      const check = $<HTMLElement>("[data-check]")
      const apply = (node: HTMLElement) => {
        const next = result.nodes[node.dataset.node as keyof typeof result.nodes]
        node.dataset.state = next.state
        node.querySelector("[data-mark]")!.textContent = marks[next.state]
        node.querySelector("[data-note]")!.textContent = next.note
      }
      if (reduced()) {
        nodes.forEach(apply)
        check.dataset.check = result.check
        terminal.textContent = result.lines.join("\n")
        return
      }
      // Replay the run: each step lights up in order and the terminal streams.
      nodes.forEach(node => { node.dataset.state = "queued"; node.querySelector("[data-mark]")!.textContent = "○" })
      check.dataset.check = "queued"
      edges.forEach(edge => edge.removeAttribute("data-flow"))
      terminal.textContent = ""
      const sequence = [edges[0], ...nodes.flatMap((node, index) => [node, edges[index + 1]])]
      sequence.forEach((element, index) => timers.push(window.setTimeout(() => {
        if (element.dataset.node) apply(element)
        else element.setAttribute("data-flow", "")
      }, 140 + index * 190)))
      timers.push(window.setTimeout(() => (check.dataset.check = result.check), 140 + sequence.length * 190))
      result.lines.forEach((line, index) => timers.push(window.setTimeout(() => {
        terminal.textContent += (index ? "\n" : "") + line
      }, 80 + index * 110)))
    }

    root.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-set]")
      if (!button) return
      root.dataset[button.dataset.set!] = button.dataset.value
      if (button.dataset.set !== "approval") root.dataset.approval = "pending"
      render()
    }, { signal: controller.signal })

    return () => { controller.abort(); timers.forEach(clearTimeout) }
  })
</script>

<style>
  .hiw { margin-bottom: 2.5rem; }
  .lead { font-size: 1.15rem; line-height: 1.6; color: var(--nb-foreground); text-wrap: pretty; margin: 0 0 1rem; }
  .cta { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 2.25rem; }
  .cta a { padding: .5rem .9rem; border-radius: var(--nb-radius); border: 1px solid var(--nb-border-strong); color: var(--nb-foreground); text-decoration: none; font-weight: 500; font-size: .9rem; }
  .cta a.primary { background: var(--nb-primary); color: var(--nb-primary-foreground); border-color: var(--nb-primary); }
  .cta a:hover { border-color: var(--nb-foreground); }
  h2 { margin: 0 0 1rem; font-size: 1.7rem; line-height: 1.2; color: var(--nb-foreground); }

  .stages { list-style: none; padding: 0; margin: 0 0 1.25rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .6rem; counter-reset: none; }
  .stages li { display: flex; flex-direction: column; gap: .3rem; padding: .8rem; border: 1px solid var(--nb-border); border-radius: var(--nb-radius); background: var(--nb-card); font-size: .82rem; line-height: 1.4; color: var(--nb-muted-foreground); margin: 0; position: relative; }
  .stages li + li::before { content: "→"; position: absolute; left: -.55rem; top: .9rem; color: var(--nb-muted-foreground); background: var(--nb-background); font-size: .8rem; line-height: 1; }
  .stages strong { color: var(--nb-foreground); font-size: .92rem; }
  .stages code { margin-top: auto; align-self: flex-start; font-size: .72rem; }
  .n { display: inline-grid; place-items: center; width: 1.35rem; height: 1.35rem; border-radius: 999px; background: var(--nb-brand-wash); color: var(--nb-brand); font-weight: 700; font-size: .72rem; }

  .sim { border: 1px solid var(--nb-border); border-radius: calc(var(--nb-radius) * 1.5); background: var(--nb-card); padding: 1rem; box-shadow: var(--nb-shadow-sm); }
  .controls { display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; margin-bottom: 1rem; }
  fieldset { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: .3rem; }
  legend { float: left; margin-right: .4rem; font-size: .72rem; font-family: var(--nb-font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--nb-muted-foreground); }
  button { font: inherit; font-size: .8rem; padding: .3rem .6rem; border-radius: 999px; border: 1px solid var(--nb-border-strong); background: var(--nb-background); color: var(--nb-foreground); cursor: pointer; }
  button code { font-size: .75rem; background: none; padding: 0; }
  button:hover { border-color: var(--nb-foreground); }
  button[aria-pressed="true"] { background: var(--nb-primary); color: var(--nb-primary-foreground); border-color: var(--nb-primary); }
  button:focus-visible { outline: 2px solid var(--nb-ring); outline-offset: 2px; }

  .stage { display: flex; align-items: center; gap: 0; padding: .25rem 0 .5rem; overflow-x: auto; }
  .chip { flex: none; display: flex; flex-direction: column; align-items: center; padding: .5rem .7rem; border-radius: var(--nb-radius); border: 1.5px solid var(--nb-border-strong); background: var(--nb-background); font-family: var(--nb-font-mono); font-size: .8rem; font-weight: 600; color: var(--nb-foreground); }
  .kicker { font-size: .6rem; font-weight: 500; text-transform: uppercase; letter-spacing: .1em; color: var(--nb-muted-foreground); }
  .check[data-check="passed"] { border-color: var(--nb-success); background: var(--nb-success-muted); }
  .check[data-check="failed"] { border-color: var(--nb-danger); background: var(--nb-danger-muted); }
  .check[data-check="waiting"] { border-color: var(--nb-warning); background: var(--nb-warning-muted); }
  .check[data-check="skipped"], .check[data-check="queued"] { border-style: dashed; }

  .runner { flex: 1; min-width: 0; position: relative; border: 1.5px dashed var(--nb-border-strong); border-radius: calc(var(--nb-radius) * 1.25); padding: 1.75rem .6rem .6rem; background: color-mix(in oklch, var(--nb-brand) 3%, transparent); }
  .runner-label { position: absolute; top: .45rem; left: .65rem; font-family: var(--nb-font-mono); font-size: .62rem; line-height: 1; text-transform: uppercase; letter-spacing: .12em; color: var(--nb-muted-foreground); }
  .graph { display: flex; align-items: stretch; }
  .node { flex: 1 1 0; min-width: 5.5rem; display: flex; flex-direction: column; gap: .15rem; padding: .5rem .55rem; border-radius: var(--nb-radius); border: 1.5px solid var(--nb-border-strong); background: var(--nb-card); transition: border-color .2s, background-color .2s, opacity .2s, transform .2s; }
  .node .mark { font-weight: 700; font-size: .9rem; line-height: 1; }
  .node .name { font-family: var(--nb-font-mono); font-size: .78rem; font-weight: 600; color: var(--nb-foreground); }
  .node .note { font-size: .68rem; line-height: 1.3; color: var(--nb-muted-foreground); }
  .node[data-state="passed"] { border-color: var(--nb-success); } .node[data-state="passed"] .mark { color: var(--nb-success); }
  .node[data-state="cached"] { border-color: var(--nb-info); background: var(--nb-info-muted); } .node[data-state="cached"] .mark { color: var(--nb-info); }
  .node[data-state="waiting"] { border-color: var(--nb-warning); background: var(--nb-warning-muted); } .node[data-state="waiting"] .mark { color: var(--nb-warning-foreground); }
  .node[data-state="failed"] { border-color: var(--nb-danger); background: var(--nb-danger-muted); } .node[data-state="failed"] .mark { color: var(--nb-danger); }
  .node[data-state="skipped"] { border-style: dashed; opacity: .6; }
  .node[data-state="queued"] { opacity: .45; }

  .edge { flex: 0 0 1.1rem; align-self: center; height: 2px; position: relative; background: var(--nb-border-strong); overflow: hidden; }
  .edge[data-flow]::after { content: ""; position: absolute; top: 0; left: -40%; width: 40%; height: 100%; background: var(--nb-brand); animation: flow .5s ease-out forwards; }
  @keyframes flow { to { left: 100%; } }

  .gate { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin-top: .6rem; padding: .5rem .7rem; border-radius: var(--nb-radius); background: var(--nb-warning-muted); border: 1px solid color-mix(in oklch, var(--nb-warning) 35%, transparent); font-size: .82rem; }
  .gate span { margin-right: auto; font-weight: 500; }
  .gate[hidden], [hidden] { display: none; }

  .summary { margin: .8rem 0 .5rem; font-weight: 600; font-size: .92rem; color: var(--nb-foreground); }
  .terminal { margin: 0; min-height: 13.5em; padding: .8rem 1rem; border-radius: var(--nb-radius); background: oklch(0.18 0 0); color: oklch(0.92 0 0); font-family: var(--nb-font-mono); font-size: .74rem; line-height: 1.5; white-space: pre-wrap; overflow-x: auto; }
  .fine { margin: .6rem 0 0; font-size: .75rem; color: var(--nb-muted-foreground); }
  .fine a { color: var(--nb-brand); }

  @media (max-width: 40rem) {
    .stages { grid-template-columns: 1fr 1fr; }
    .stages li + li::before { display: none; }
    .stage { flex-direction: column; align-items: stretch; }
    .stage > .edge { flex-basis: 1rem; width: 2px; height: 1rem; }
    .graph { flex-direction: column; }
    .graph > .edge { width: 2px; height: .8rem; flex-basis: .8rem; }
    .chip { flex-direction: row; gap: .5rem; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .node { transition: none; }
    .edge[data-flow]::after { animation: none; }
  }
</style>
