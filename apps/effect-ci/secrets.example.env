GITHUB_APP_ID=<app-id>
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
<private-key>
-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=<github-webhook-secret>
EFFECT_CI_API_TOKEN=<effect-ci-api-token>
EFFECT_CI_PUBLIC_URL=https://effect-ci.<subdomain>.workers.dev
# Optional channel notifications (also used for HITL review links).
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Or use an existing Slack app (preferred for one live-updated status message).
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C...
# Inline Slack approval callbacks (all required to enable decision buttons).
# SLACK_SIGNING_SECRET=<slack-signing-secret>
# SLACK_APP_ID=A...
# SLACK_TEAM_ID=T...
# SLACK_APPROVER_IDS=U...
# EFFECT_CI_DETAILS_URL=https://dash.cloudflare.com/<account-id>/workers/workflows/effect-ci/instance/{id}
# Optional: require a comment modal instead of one-click HMD decisions.
# HMD_REQUIRE_RATIONALE=true
# Auto-progress inconclusive or near-margin stages after 1–5 minutes (default 2).
# Regressions still require explicit Progress; timer restores instead.
# HMD_AUTO_PROGRESS_MINUTES=2

# Hosted OIDC: the same app enrolls repositories and issues short-lived deployment tokens.
# CLOUDFLARE_ACCOUNT_ID=<account-id>
# EFFECT_CI_OIDC_OWNER_IDS=<numeric-github-owner-id>
# EFFECT_CI_OIDC_SCOPES={"workers:edit":[<approved-cloudflare-policy-object>]}
# CLOUDFLARE_TOKEN_ISSUER=<account-token-creation-credential>
# RECEIPT_SIGNING_KEY=<at-least-32-random-characters>
# Optional Access-only enrollment (otherwise use the existing Worker API token).
# EFFECT_CI_ACCESS_ISSUER=https://<team>.cloudflareaccess.com
# EFFECT_CI_ACCESS_AUD=<Access-service-application-audience>
