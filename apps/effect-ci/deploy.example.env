CLOUDFLARE_ACCOUNT_ID=<account-id>
EFFECT_CI_PUBLIC_URL=https://effect-ci-github-cloudflare.<subdomain>.workers.dev
EFFECT_CI_ACCESS_REVIEWERS=<reviewer-email>
# Optional: ID of an existing Access service token, not its client secret.
# EFFECT_CI_ACCESS_SERVICE_TOKEN_ID=<service-token-id>
# Opt-in narrow, signature-authenticated /webhooks/slack Access exception.
# EFFECT_CI_SLACK_CALLBACKS=true
